{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unity Architect Pro Multiplayer Laboratory Result",
  "type": "object",
  "required": ["schemaVersion", "scenario", "result", "processes", "actions", "failures", "artifacts"],
  "properties": {
    "schemaVersion": {"const": 2}, "scenario": {"type": "string"}, "scenarioId": {"type": "string"},
    "seed": {"type": "integer"}, "startedUtc": {"type": "string"}, "durationSeconds": {"type": "number"},
    "build": {"type": "object"}, "topology": {"type": "string"}, "conditions": {"type": "object"},
    "result": {"enum": ["passed", "failed", "timeout", "inconclusive"]},
    "processes": {"type": "array", "items": {"type": "object", "required": ["name", "role", "generation", "ready", "completed"]}},
    "actions": {"type": "array", "items": {"type": "object"}}, "metrics": {"type": "object"},
    "failures": {"type": "array", "items": {"type": "object"}}, "artifacts": {"type": "array", "items": {"type": "string"}}
  }
}
