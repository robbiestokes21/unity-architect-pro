{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unity Architect Pro gameplay scenario",
  "type": "object",
  "required": ["schemaVersion", "id", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "captureStateAfterEachStep": { "type": "boolean" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "action": { "$ref": "#/$defs/operation" },
          "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } }
        }
      }
    }
  },
  "$defs": {
    "parameter": { "type": "object", "required": ["key", "value"], "properties": { "key": { "type": "string" }, "value": { "type": "string" } } },
    "operation": {
      "type": "object",
      "required": ["adapter", "kind"],
      "properties": {
        "adapter": { "type": "string" },
        "kind": { "type": "string" },
        "timeoutSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } }
      }
    },
    "assertion": { "allOf": [{ "$ref": "#/$defs/operation" }], "properties": { "message": { "type": "string" } } }
  }
}
